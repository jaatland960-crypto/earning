    time--;
    countdown.innerHTML = "00 : 00 : 00 : " + (time < 10 ? "0" + time : time);

    if(time <= 0){
        clearInterval(interval);
        window.location.href = "https://t.me/+NbYRlZbIDn5hOTJl";
    }
}, 1000);
</script>

